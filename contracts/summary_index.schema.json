{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A-Share-ETF-Flow daily summary index v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "updated_at": {
      "type": "string",
      "description": "Local file update time without timezone; not an economic date."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asof": {
            "type": "string",
            "format": "date"
          },
          "report_status": {
            "enum": [
              "正式报告",
              "预览/数据待补全"
            ]
          },
          "formal_report_allowed": {
            "type": "boolean"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "flow_1d_100m": {
            "type": [
              "number",
              "null"
            ]
          },
          "flow_5d_100m": {
            "type": [
              "number",
              "null"
            ]
          },
          "total_size_100m": {
            "type": [
              "number",
              "null"
            ]
          },
          "flow_size_coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "quote_coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "share_coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "nav_coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "quote_fresh_coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "share_fresh_coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "nav_fresh_coverage": {
            "type": [
              "number",
              "null"
            ]
          },
          "flow_valid_etf_count": {
            "type": "integer",
            "minimum": 0
          },
          "flow_missing_etf_count": {
            "type": "integer",
            "minimum": 0
          },
          "extreme_flow_unresolved_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "asof",
          "report_status",
          "formal_report_allowed",
          "content_hash",
          "flow_1d_100m",
          "flow_5d_100m",
          "total_size_100m",
          "flow_size_coverage",
          "quote_coverage",
          "share_coverage",
          "nav_coverage",
          "quote_fresh_coverage",
          "share_fresh_coverage",
          "nav_fresh_coverage",
          "flow_valid_etf_count",
          "flow_missing_etf_count",
          "extreme_flow_unresolved_count"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "updated_at",
    "entries"
  ],
  "additionalProperties": false
}
