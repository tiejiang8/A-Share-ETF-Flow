      "properties": {
        "quote_coverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "share_coverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "nav_coverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "quote_fresh_coverage": {
          "type": [
            "number",
            "null"
          ]
        },
