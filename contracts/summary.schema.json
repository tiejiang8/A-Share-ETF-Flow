        "flow_member_coverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "flow_size_coverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "weighted_share_coverage": {
          "type": [
            "number",
            "null"
          ]
        },
        "missing_flow_size_100m": {
          "type": [
            "number",
            "null"
          ]
        },
        "official_ratio": {
          "type": [
            "number",
            "null"
          ]
        },
        "browser_fallback_count": {
          "type": "integer",
