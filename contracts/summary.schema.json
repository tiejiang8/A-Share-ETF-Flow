  "required": [
    "schema_version",
    "asof",
    "report_status",
    "formal_report_allowed",
    "formal_blockers",
    "content_hash",
    "scope",
    "method",
    "coverage",
    "data_dates",
    "market",
    "clusters",
    "top_inflow_etfs",
    "top_outflow_etfs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "required": [
              "synthetic_demo"
            ],
            "properties": {
              "synthetic_demo": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "formal_report_allowed": {
            "const": false
          }
        }
      }
    }
  ]
