    "top_inflow_etfs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "etf_code": {
            "type": "string"
          },
          "etf_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "cluster_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "flow_1d_100m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "flow_5d_100m": {
