          "etf_code": {
            "type": "string"
          },
          "etf_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "cluster_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "flow_1d_100m": {
            "type": "number",
            "exclusiveMaximum": 0
          },
          "flow_5d_100m": {
            "type": [
              "number",
