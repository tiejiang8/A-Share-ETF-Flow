{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A-Share-ETF-Flow daily summary v1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "asof": {
      "type": "string",
      "format": "date"
    },
    "report_status": {
      "enum": [
        "正式报告",
        "预览/数据待补全"
      ]
    },
    "formal_report_allowed": {
      "type": "boolean"
    },
    "formal_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "universe": {
          "type": "string"
        },
        "etf_count": {
          "type": "integer",
          "minimum": 0
        },
        "cluster_count": {
          "type": "integer",
          "minimum": 0
        },
        "identity_note": {
          "type": "string"
        },
        "synthetic_demo": {
          "type": "boolean"
        }
      },
      "required": [
        "universe",
        "etf_count",
        "cluster_count",
        "identity_note"
      ],
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "properties": {
        "net_subscription_formula": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "share_unit": {
          "type": "string"
        },
        "nav_unit": {
          "type": "string"
        },
        "flow_1d_definition": {
          "type": "string"
        },
        "flow_5d_definition": {
          "type": "string"
        },
        "yuan_per_100m": {
          "const": 100000000
        },
        "caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "net_subscription_formula",
        "unit",
        "share_unit",
        "nav_unit",
        "flow_1d_definition",
        "flow_5d_definition",
        "yuan_per_100m",
        "caveats"
      ],
      "additionalProperties": false
    },
