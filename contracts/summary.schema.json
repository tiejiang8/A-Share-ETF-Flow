        "missing_quote_codes",
        "missing_share_codes",
        "missing_nav_codes",
        "coverage_note"
      ],
      "additionalProperties": false
    },
    "data_dates": {
      "type": "object",
      "properties": {
        "report_date": {
          "type": "string",
          "format": "date"
